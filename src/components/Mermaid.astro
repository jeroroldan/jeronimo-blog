---
// Sin props: detecta bloques ```mermaid del Markdown/MDX y los renderiza en cliente.
// Carga diferida: si el post no tiene diagramas, mermaid nunca se descarga.
---

<style is:global>
  /* Contenedor del diagrama: overflow-x-auto + p-4 + bg-slate-900/80 + rounded-xl */
  .mermaid-block {
    overflow-x: auto;
    padding: 1rem; /* p-4 */
    margin: 1.75em 0;
    background: rgba(2, 6, 23, 0.8); /* bg-slate-900/80, siempre oscuro para contraste */
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 0.75rem; /* rounded-xl */
  }
  .mermaid-block .mermaid {
    display: flex;
    justify-content: center;
    min-width: min-content;
  }
  .mermaid-block .mermaid svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
  /* Mensaje de error legible si un diagrama tiene sintaxis inválida */
  .mermaid-error {
    color: #fca5a5;
    font-size: 0.85rem;
    font-family: monospace;
    white-space: pre-wrap;
  }
</style>

<script>
  async function renderMermaid() {
    const root = document.querySelector('.prose-content');
    if (!root || root.querySelector('[data-mermaid-done]')) return;

    // expressive-code → pre[data-language="mermaid"] | markdown clásico → pre > code.language-mermaid
    const blocks = root.querySelectorAll(
      'pre[data-language="mermaid"], pre > code.language-mermaid'
    );
    if (!blocks.length) return;

    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      theme: 'dark', // match con el dark mode: evita pasteles chillones y texto ilegible
      themeVariables: {
        darkMode: true,
        background: '#0f172a',
        primaryColor: '#1e293b',
        primaryTextColor: '#e2e8f0',
        primaryBorderColor: '#818cf8',
        lineColor: '#818cf8',
        secondaryColor: '#312e81',
        secondaryTextColor: '#e2e8f0',
        tertiaryColor: '#0f172a',
        tertiaryTextColor: '#cbd5e1',
        textColor: '#cbd5e1',
        nodeBorder: '#818cf8',
        clusterBkg: 'rgba(129, 140, 248, 0.08)',
        clusterBorder: '#475569',
        edgeLabelBackground: '#0f172a',
        actorBkg: '#1e293b',
        actorBorder: '#818cf8',
        actorTextColor: '#e2e8f0',
      },
      flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis' },
    });

    let i = 0;
    for (const block of blocks) {
      const pre = block instanceof HTMLPreElement ? block : block.closest('pre');
      if (!pre) continue;
      // expressive-code envuelve el <pre> en .expressive-code: se reemplaza el contenedor completo
      const container = pre.closest('.expressive-code') ?? pre;
      const source = (pre.textContent ?? '').trim();
      if (!source) continue;

      const wrap = document.createElement('div');
      wrap.className = 'mermaid-block';
      wrap.setAttribute('data-mermaid-done', '');
      const diagram = document.createElement('div');
      diagram.className = 'mermaid';
      diagram.textContent = source;
      wrap.appendChild(diagram);
      container.replaceWith(wrap);

      try {
        await mermaid.run({ nodes: [diagram] });
      } catch (err) {
        console.error('[mermaid] no se pudo renderizar el diagrama:', err);
        diagram.innerHTML = '';
        const fallback = document.createElement('p');
        fallback.className = 'mermaid-error';
        fallback.textContent = 'Diagrama no disponible (sintaxis inválida). Código original:\n' + source;
        diagram.appendChild(fallback);
      }
      i++;
      // Cede el hilo entre diagramas para no bloquear el pintado en posts largos
      if (i % 2 === 0) await new Promise((r) => requestAnimationFrame(r));
    }
  }

  document.addEventListener('DOMContentLoaded', renderMermaid);
  // Re-ejecuta tras navegaciones del ClientRouter de Astro
  document.addEventListener('astro:page-load', renderMermaid);
</script>
