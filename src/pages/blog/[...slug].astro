---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getReadingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, allPosts: posts.map((p) => ({ id: p.id, data: { title: p.data.title, description: p.data.description, tags: p.data.tags ?? [], track: (p.data as any).track, code: p.data.code, category: p.data.category } })) },
	}));
}
type Props = { post: CollectionEntry<'blog'>; allPosts: { id: string; data: { title: string; description: string; tags?: string[]; track?: string; code?: string; category?: string } }[] };

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
// Tiempo estimado: frontmatter explícito > cálculo desde el cuerpo (~200 wpm)
const readingMinutes =
	typeof (post.data as any).readingTime === 'number'
		? (post.data as any).readingTime
		: getReadingTime(post.body);
---

<BlogPost {...post.data} headings={headings} slug={post.id} related={allPosts} readingMinutes={readingMinutes}>
	<Content />
</BlogPost>
