---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ReadIndicator from '../components/ReadIndicator.astro';
import Gallery from '../components/Gallery.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import DefaultImage from '../assets/blog-placeholder-1.jpg';
import amigos from '../assets/amigos.jpg';
import analogiaPatrones from '../assets/analogia-patrones.jpg';
import aoGenerative from '../assets/aogenerative.png';
import bistBytes from '../assets/bistbytes.png';
import blogPlaceholder1 from '../assets/blog-placeholder-1.jpg';
import blogPlaceholder2 from '../assets/blog-placeholder-2.jpg';
import blogPlaceholder3 from '../assets/blog-placeholder-3.jpg';
import blogPlaceholder4 from '../assets/blog-placeholder-4.jpg';
import blogPlaceholder5 from '../assets/blog-placeholder-5.jpg';
import blogPlaceholderAbout from '../assets/blog-placeholder-about.jpg';
import clipping from '../assets/clipping.png';
import cuestionar from '../assets/cuestionar.jpg';
import dinero from '../assets/dinero.png';
import especializa from '../assets/especializa.jpg';
import figma01 from '../assets/figma01.png';
import figma02 from '../assets/figma02.png';
import figma03 from '../assets/figma03.png';
import iaGenerative from '../assets/IAgenerative.png';
import iot01 from '../assets/iot-01.jpg';
import iot02 from '../assets/iot-02.jpg';
import iot03 from '../assets/iot-03.jpg';
import patrones from '../assets/patrones.jpg';
import procratisnacion from '../assets/procratisnacion.jpg';
import sed from '../assets/sed.jpg';
import sedu from '../assets/sedu.jpg';
import whole from '../assets/whole.png';

const allPosts = await getCollection('blog');
const posts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const totalPosts = allPosts.length;
const uniqueCategories = [...new Set(allPosts.map(p => p.data.category).filter((c): c is string => Boolean(c)))];
const totalCategories = uniqueCategories.length;
const categories = uniqueCategories.slice(0, 8);

const galleryImages = [
	{ src: iot01, alt: 'Dispositivos IoT conectados', caption: 'Internet de las Cosas: cómo los objetos cotidianos se conectan y comparten datos.' },
	{ src: iot02, alt: 'Arquitectura de un sistema IoT', caption: 'Arquitectura IoT: sensores, conectividad y la nube trabajando en conjunto.' },
	{ src: iot03, alt: 'Aplicaciones de IoT', caption: 'Casos de uso de IoT: hogar, industria y ciudades inteligentes.' },
	{ src: amigos, alt: 'Personas colaborando en equipo', caption: 'Habilidades sociales: construir relaciones que suman en tu vida.' },
	{ src: cuestionar, alt: 'Pensamiento crítico', caption: 'Pensamiento crítico: cuestiona para aprender mejor cada día.' },
	{ src: analogiaPatrones, alt: 'Aprender por analogías y patrones', caption: 'Pensamiento de patrones: aprende reconociendo similitudes entre temas.' },
	{ src: patrones, alt: 'Patrones visuales', caption: 'Patrones: la base del aprendizaje, la creatividad y la resolución de problemas.' },
	{ src: aoGenerative, alt: 'IA generativa', caption: 'IA generativa: crea contenido e ideas con inteligencia artificial.' },
	{ src: iaGenerative, alt: 'IA generativa aplicada', caption: 'IA generativa aplicada a proyectos y flujos de trabajo reales.' },
	{ src: bistBytes, alt: 'Bites de conocimiento', caption: 'Bites de conocimiento: ideas pequeñas que suman mucho aprendizaje.' },
	{ src: clipping, alt: 'Clipping de video', caption: 'Clipping de video: sintetiza información clave en segundos.' },
	{ src: dinero, alt: 'Educación financiera', caption: 'Educación financiera: entiende el flujo del dinero y su propósito.' },
	{ src: especializa, alt: 'Especialización', caption: 'Especialización: profundiza en un tema para destacar y crear valor.' },
	{ src: figma01, alt: 'Diseño en Figma paso 1', caption: 'Diseño con Figma: del boceto inicial a la interfaz.' },
	{ src: figma02, alt: 'Diseño en Figma paso 2', caption: 'Diseño con Figma: componentes y sistemas reutilizables.' },
	{ src: figma03, alt: 'Diseño en Figma paso 3', caption: 'Diseño con Figma: prototipos listos para validar.' },
	{ src: procratisnacion, alt: 'Vence la procrastinación', caption: 'Vence la procrastinación: la acción pequeña y diaria lo cambia todo.' },
	{ src: sed, alt: 'Comunicación y seducción', caption: 'Comunicación y conexión: el lenguaje que acerca a las personas.' },
	{ src: sedu, alt: 'Inteligencia social', caption: 'Inteligencia social: lee, comprende e influye con respeto.' },
	{ src: whole, alt: 'Visión integral', caption: 'Visión integral: une las piezas del conocimiento en un todo.' },
	{ src: blogPlaceholder1, alt: 'Aprende visualmente', caption: 'Aprende visualmente: cada imagen es una puerta a un tema nuevo.' },
	{ src: blogPlaceholder2, alt: 'Explora un tema', caption: 'Explora un tema a tu ritmo, sin presión de leer todo.' },
	{ src: blogPlaceholder3, alt: 'Ideas en imágenes', caption: 'Ideas en imágenes: cuando no quieras leer, mira y aprende.' },
	{ src: blogPlaceholder4, alt: 'Inspiración diaria', caption: 'Inspiración diaria: una imagen puede disparar una gran idea.' },
	{ src: blogPlaceholder5, alt: 'Conocimiento en minutos', caption: 'Conocimiento en minutos: aprendizaje rápido y visual.' },
	{ src: blogPlaceholderAbout, alt: 'Sobre el blog', caption: 'Sobre el blog: una biblioteca viva de temas para crecer.' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<ClientRouter />
	</head>
	<body>
		<Header />
		<main class="home-container">
			<section class="home-hero animate-fade-in">
				<h1>Bienvenido a {SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
				<div class="hero-stats">
					<div class="stat">
						<span class="stat-number">{totalPosts}</span>
						<span class="stat-label">Artículos</span>
					</div>
					<div class="stat">
						<span class="stat-number">{totalCategories}</span>
						<span class="stat-label">Categorías</span>
					</div>
				</div>
				<div class="cta-group">
					<a href="/blog" class="btn-primary">Explorar Blog</a>
					<a href="#categories" class="btn-secondary">Ver Categorías</a>
				</div>
			</section>

			<section class="reading-benefits-section">
				<div class="section-header">
					<h2>El poder de leer todos los días</h2>
				</div>
				<p class="reading-benefits-intro">
					La lectura constante es uno de los hábitos más transformadores que puedes cultivar.
					Cada página que recorres fortalece tu mente, amplía tu mundo y te acerca a la mejor versión de ti mismo.
				</p>
				<div class="benefits-grid">
					{[
						{ icon: '📚', title: 'Expande tu mente', text: 'Cada libro te acerca a nuevas ideas, culturas y formas de ver el mundo.' },
						{ icon: '🧠', title: 'Mejora tu concentración', text: 'Leer entrena tu capacidad de enfoque profundo en un mundo lleno de distracciones.' },
						{ icon: '😌', title: 'Reduce el estrés', text: 'Unos minutos de lectura diaria calman la mente y te ayudan a recargar energías.' },
						{ icon: '💡', title: 'Potencia tu creatividad', text: 'La lectura despierta la imaginación y te inspira a crear sin límites.' },
						{ icon: '🚀', title: 'Acelera tu crecimiento', text: 'Aprende de los mejores pensadores y acelera tu desarrollo personal y profesional.' },
						{ icon: '💬', title: 'Mejora tu comunicación', text: 'Enriquece tu vocabulario, claridad y confianza al expresar tus ideas.' },
					].map((benefit) => (
						<div class="benefit-card">
							<div class="benefit-icon">{benefit.icon}</div>
							<div class="benefit-content">
								<h3>{benefit.title}</h3>
								<p>{benefit.text}</p>
							</div>
						</div>
					))}
				</div>
			</section>

			<section class="recent-posts">
				<div class="section-header">
					<h2>Posts Recientes</h2>
					<a href="/blog" class="view-all">Ver todo →</a>
				</div>
				<div class="posts-grid">
					{posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-card animate-fade-in" data-slug={post.id}>
							<div class="post-card-image-wrapper">
								<Image
									src={post.data.heroImage && typeof post.data.heroImage === 'object' ? post.data.heroImage : DefaultImage}
									alt={post.data.title}
									class="post-card-image"
									width={400}
									height={225}
								/>
								{post.data.category && (
									<span class="post-card-badge">{post.data.category}</span>
								)}
							</div>
							<div class="post-card-content">
								<h3 class="post-card-title">{post.data.title}</h3>
								<p class="post-card-excerpt">{post.data.description}</p>
								<div class="post-card-meta">
									<span>
										<FormattedDate date={post.data.pubDate} />
									</span>
									{post.data.readingTime && (
										<span>{post.data.readingTime} min</span>
									)}
								</div>
							</div>
						</a>
					))}
				</div>
			</section>

			<Gallery
				title="Aprende visualmente"
				subtitle="Cuando no quieras leer, mira y aprende de distintos temas."
				images={galleryImages}
			/>

			<section id="categories" class="categories-section">
				<div class="section-header">
					<h2>Explora por tema</h2>
				</div>
				<div class="categories-grid">
					{categories.map((cat) => (
						<a href={`/blog?category=${encodeURIComponent(cat)}`} class="category-card">
							<span class="category-icon">📂</span>
							<span>{cat}</span>
						</a>
					))}
				</div>
			</section>

			<section class="newsletter-section animate-fade-in">
				<h2>¡No te pierdas nada!</h2>
				<p>Recibe los mejores artículos sobre desarrollo personal, tecnología, trading y más directamente en tu correo.</p>
				<form class="newsletter-form" onsubmit="alert('¡Gracias por suscribirte! (Demo)'); return false;">
					<input type="email" class="newsletter-input" placeholder="tu@email.com" required />
					<button type="submit" class="newsletter-submit">Suscribirme</button>
				</form>
			</section>
		</main>
		<Footer />
		<ReadIndicator />
	</body>
</html>

