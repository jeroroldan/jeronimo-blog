---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ReadIndicator from '../components/ReadIndicator.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import DefaultImage from '../assets/blog-placeholder-1.jpg';

const allPosts = await getCollection('blog');
const posts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const totalPosts = allPosts.length;
const uniqueCategories = [...new Set(allPosts.map(p => p.data.category).filter(Boolean))];
const totalCategories = uniqueCategories.length;
const categories = uniqueCategories.slice(0, 8);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<ClientRouter />
	</head>
	<body>
		<Header />
		<main class="home-container">
			<section class="home-hero animate-fade-in">
				<h1>Bienvenido a {SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
				<div class="hero-stats">
					<div class="stat">
						<span class="stat-number">{totalPosts}</span>
						<span class="stat-label">Artículos</span>
					</div>
					<div class="stat">
						<span class="stat-number">{totalCategories}</span>
						<span class="stat-label">Categorías</span>
					</div>
				</div>
				<div class="cta-group">
					<a href="/blog" class="btn-primary">Explorar Blog</a>
					<a href="#categories" class="btn-secondary">Ver Categorías</a>
				</div>
			</section>

			<section class="reading-benefits-section">
				<div class="section-header">
					<h2>El poder de leer todos los días</h2>
				</div>
				<p class="reading-benefits-intro">
					La lectura constante es uno de los hábitos más transformadores que puedes cultivar.
					Cada página que recorres fortalece tu mente, amplía tu mundo y te acerca a la mejor versión de ti mismo.
				</p>
				<div class="benefits-grid">
					{[
						{ icon: '📚', title: 'Expande tu mente', text: 'Cada libro te acerca a nuevas ideas, culturas y formas de ver el mundo.' },
						{ icon: '🧠', title: 'Mejora tu concentración', text: 'Leer entrena tu capacidad de enfoque profundo en un mundo lleno de distracciones.' },
						{ icon: '😌', title: 'Reduce el estrés', text: 'Unos minutos de lectura diaria calman la mente y te ayudan a recargar energías.' },
						{ icon: '💡', title: 'Potencia tu creatividad', text: 'La lectura despierta la imaginación y te inspira a crear sin límites.' },
						{ icon: '🚀', title: 'Acelera tu crecimiento', text: 'Aprende de los mejores pensadores y acelera tu desarrollo personal y profesional.' },
						{ icon: '💬', title: 'Mejora tu comunicación', text: 'Enriquece tu vocabulario, claridad y confianza al expresar tus ideas.' },
					].map((benefit) => (
						<div class="benefit-card">
							<div class="benefit-icon">{benefit.icon}</div>
							<div class="benefit-content">
								<h3>{benefit.title}</h3>
								<p>{benefit.text}</p>
							</div>
						</div>
					))}
				</div>
			</section>

			<section class="recent-posts">
				<div class="section-header">
					<h2>Posts Recientes</h2>
					<a href="/blog" class="view-all">Ver todo →</a>
				</div>
				<div class="posts-grid">
					{posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="post-card animate-fade-in" data-slug={post.id}>
							<div class="post-card-image-wrapper">
								<Image
									src={post.data.heroImage && typeof post.data.heroImage === 'object' ? post.data.heroImage : DefaultImage}
									alt={post.data.title}
									class="post-card-image"
									width={400}
									height={225}
								/>
								{post.data.category && (
									<span class="post-card-badge">{post.data.category}</span>
								)}
							</div>
							<div class="post-card-content">
								<h3 class="post-card-title">{post.data.title}</h3>
								<p class="post-card-excerpt">{post.data.description}</p>
								<div class="post-card-meta">
									<span>
										<FormattedDate date={post.data.pubDate} />
									</span>
									{post.data.readingTime && (
										<span>{post.data.readingTime} min</span>
									)}
								</div>
							</div>
						</a>
					))}
				</div>
			</section>

			<section id="categories" class="categories-section">
				<div class="section-header">
					<h2>Explora por tema</h2>
				</div>
				<div class="categories-grid">
					{categories.map((cat) => (
						<a href={`/blog?category=${encodeURIComponent(cat)}`} class="category-card">
							<span class="category-icon">📂</span>
							<span>{cat}</span>
						</a>
					))}
				</div>
			</section>

			<section class="newsletter-section animate-fade-in">
				<h2>¡No te pierdas nada!</h2>
				<p>Recibe los mejores artículos sobre desarrollo personal, tecnología, trading y más directamente en tu correo.</p>
				<form class="newsletter-form" onsubmit="event.preventDefault(); alert('¡Gracias por suscribirte! (Demo)');">
					<input type="email" class="newsletter-input" placeholder="tu@email.com" required />
					<button type="submit" class="newsletter-submit">Suscribirme</button>
				</form>
			</section>
		</main>
		<Footer />
		<ReadIndicator />
	</body>
</html>

