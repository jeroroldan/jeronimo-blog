---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReadAloud from '../components/ReadAloud.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LevelBadge from '../components/LevelBadge.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import DefaultImage from '../assets/blog-placeholder-1.jpg';
import { resolveTrack, getSubtrackFromCode } from '../lib/tracks';

type Props = CollectionEntry<'blog'>['data'] & {
  slug?: string;
  headings?: Heading[];
  readingMinutes?: number;
  related?: { id: string; data: { title: string; description: string; tags?: string[]; track?: string; code?: string; category?: string } }[];
};
type Heading = { depth: number; slug: string; text: string };

const { title, description, pubDate, updatedDate, heroImage, headings, slug, related = [], readingMinutes } = Astro.props;
const track = resolveTrack(Astro.props as any);
const subtrack = (Astro.props as any).subtrack ?? getSubtrackFromCode((Astro.props as any).code);
const level = (Astro.props as any).level as string | undefined;
const type = (Astro.props as any).type as string | undefined;
const tags = (Astro.props as any).tags as string[] | undefined;
// Etiqueta principal: GUÍA / MASTERCLASS / TUTORIAL / categoría del track
const categoryLabel = (type ?? (Astro.props as any).category ?? track.short ?? 'GUÍA').toString().toUpperCase();
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
		<ClientRouter />
		<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Article', headline: title, description, datePublished: pubDate, dateModified: updatedDate ?? pubDate, author: { '@type': 'Person', name: "Jero's Blog" } })} />
		<style>
			/* ============ Post shell: lectura centrada + sidebar ============ */
			.post-page {
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
				padding: 2rem 1.5rem 4rem;
			}
			.post-shell {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 16rem; /* contenido + w-64 */
				gap: 2.5rem;
				align-items: start;
				justify-content: center;
			}
			.post-article {
				min-width: 0;
				max-width: 48rem; /* max-w-3xl ≈ 65-75 chars/linea */
				margin: 0 auto;
				width: 100%;
			}

			/* ============ Hero: único h1 + metadata ordenada ============ */
			.post-hero { margin-bottom: 0; }
			.post-hero h1 {
				font-size: clamp(1.9rem, 4vw, 2.75rem);
				line-height: 1.15;
				letter-spacing: -0.02em;
				margin: 0.75rem 0 0.5rem;
				color: var(--text-primary);
				text-wrap: balance;
			}
			.post-dek {
				font-size: 1.125rem;
				line-height: 1.6;
				color: var(--text-secondary);
				margin: 0 0 1rem;
				text-wrap: pretty;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.6rem 1rem;
				margin: 0 0 1.25rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid var(--glass-border);
				font-size: 0.875rem;
				color: var(--text-muted);
			}
			.post-meta .meta-item {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				white-space: nowrap;
			}
			.meta-tag {
				display: inline-flex;
				align-items: center;
				padding: 0.2rem 0.7rem;
				border-radius: 999px;
				background: var(--accent-soft);
				color: var(--accent-dark);
				border: 1px solid var(--glass-border);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.06em;
			}
			body.dark-mode .meta-tag { color: var(--accent-light); }
			/* Sin espacio muerto: el contenido arranca justo después del hero */
			.post-body { margin-top: 0; }
			/* Escuchar post integrado en la fila de metadata (no bloque gigante) */
			.post-meta :global(.read-aloud-container) {
				margin: 0;
				padding: 0;
				border: none;
				background: transparent;
				box-shadow: none;
				display: inline-flex;
			}

			.hero-image {
				width: 100%;
				max-width: 48rem;
				margin: 1.5rem auto 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--glass-shadow);
				cursor: zoom-in;
			}

			/* ============ Tipografía de lectura (equiv. prose prose-invert lg:prose-lg) ============ */
			.prose-content {
				font-size: 1.075rem; /* lg ~18px */
				line-height: 1.75; /* leading-relaxed */
				color: var(--text-secondary); /* suave, no blanco puro */
				overflow-wrap: break-word;
			}
			body.dark-mode .prose-content { color: #cbd5e1; /* slate-300 */ }
			/* Elimina duplicación de título: el markdown suele empezar con # igual al h1 del hero */
			.prose-content > h1:first-child { display: none; }
			.prose-content h1 {
				font-size: 1.9rem;
				line-height: 1.3;
				margin: 0 0 1rem;
				color: var(--text-primary);
			}
			.prose-content h2 {
				font-size: 1.5rem;
				font-weight: 600; /* semibold */
				line-height: 1.35;
				margin-top: 2.5rem; /* mt-10 */
				margin-bottom: 1rem; /* mb-4 */
				color: var(--text-primary);
				scroll-margin-top: 6rem;
			}
			.prose-content h3 {
				font-size: 1.25rem;
				font-weight: 600;
				margin-top: 2.5rem;
				margin-bottom: 1rem;
				color: var(--text-primary);
				scroll-margin-top: 6rem;
			}
			.prose-content h4 { font-size: 1.1rem; font-weight: 600; margin: 2rem 0 0.75rem; color: var(--text-primary); }
			.prose-content p { margin: 1.1em 0; }
			.prose-content a { text-underline-offset: 3px; }
			.prose-content strong { color: var(--text-primary); }
			.prose-content :global(img) {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 1.75em auto;
				border-radius: 10px;
				cursor: zoom-in;
			}
			.prose-content ul, .prose-content ol { margin: 1.1em 0; padding-left: 1.5em; }
			.prose-content li { margin: 0.45em 0; }
			.prose-content li::marker { color: var(--accent); }
			.prose-content code {
				font-family: 'JetBrains Mono', monospace;
				background: var(--accent-soft);
				color: var(--accent-dark);
				padding: 0.15em 0.4em;
				border-radius: 6px;
				font-size: 0.88em;
			}
			body.dark-mode .prose-content code { color: var(--accent-light); }
			.prose-content pre {
				border: 1px solid var(--glass-border);
				border-radius: 12px;
				padding: 1.25rem;
				overflow-x: auto;
				margin: 1.75em 0;
				line-height: 1.6;
			}
			.prose-content pre code { background: transparent; color: inherit; padding: 0; }

			/* ============ Tablas y diagramas: scroll horizontal + estilos ============ */
			.table-scroll { overflow-x: auto; margin: 1.75em 0; border-radius: 12px; border: 1px solid var(--glass-border); }
			.table-scroll table { margin: 0; border: none; box-shadow: none; border-radius: 0; }
			.prose-content table {
				display: block;
				width: max-content;
				min-width: 100%;
				border-collapse: collapse;
				margin: 0;
				font-size: 0.92rem;
				overflow-x: auto;
			}
			.prose-content thead { background: rgba(148, 163, 184, 0.14); /* bg-slate-800/50 equiv. claro */ }
			body.dark-mode .prose-content thead { background: rgba(30, 41, 59, 0.6); }
			.prose-content th {
				text-align: left;
				font-weight: 600;
				padding: 0.75rem; /* p-3 */
				border-bottom: 1px solid var(--glass-border);
				color: var(--text-primary);
				white-space: nowrap;
			}
			.prose-content td {
				padding: 0.75rem; /* p-3 */
				border-bottom: 1px solid var(--glass-border);
				vertical-align: top;
			}
			.prose-content tr:last-child td { border-bottom: none; }
			.prose-content tr:nth-child(even) td { background: rgba(148, 163, 184, 0.06); }
			/* Diagramas / pre / embeds anchos no rompen el layout */
			.prose-content pre, .prose-content .mermaid, .prose-content figure { max-width: 100%; overflow-x: auto; }

			/* ============ Callouts / tarjetas (blockquote como card) ============ */
			.prose-content blockquote {
				border: 1px solid var(--glass-border);
				border-left: 4px solid var(--accent);
				background: rgba(148, 163, 184, 0.08); /* bg-slate-900/60 equiv. claro */
				border-radius: 0.75rem; /* rounded-xl */
				padding: 1rem 1.25rem;
				margin: 1.75em 0;
				font-style: normal;
				color: var(--text-secondary);
			}
			body.dark-mode .prose-content blockquote {
				background: rgba(15, 23, 42, 0.6);
				color: #cbd5e1;
			}
			.prose-content blockquote p { margin: 0.5em 0; }
			.prose-content blockquote p:first-child { margin-top: 0; }
			.prose-content blockquote p:last-child { margin-bottom: 0; }
			.prose-content blockquote strong { color: var(--text-primary); }

			/* ============ Sidebar TOC: sticky, solo xl+ ============ */
			.post-sidebar { display: none; }
			@media (min-width: 1280px) {
				.post-sidebar { display: block; }
			}
			.toc-mobile-wrap { margin-top: 1.5rem; }
			@media (min-width: 1280px) {
				.toc-mobile-wrap { display: none; }
			}

			.read-sentinel { height: 1px; width: 100%; }
			.read-badge {
				display: inline-block;
				margin: 0.75rem 0 0;
				padding: 0.25em 0.9em;
				border-radius: 999px;
				background: #2c5530;
				color: #fff;
				font-size: 0.8rem;
				font-weight: 700;
			}
			.read-badge[hidden] { display: none; }
			body.dark-mode .read-badge { background: #68d391; color: #1a202c; }

			@media (max-width: 720px) {
				.post-page { padding: 1.25rem 1rem 3rem; }
				.prose-content { font-size: 1rem; }
				.post-hero h1 { font-size: 1.65rem; }
			}

			/* Botón scroll to top */
			.scroll-to-top {
				position: fixed; bottom: 2rem; right: 2rem;
				width: 50px; height: 50px;
				background: #2C5282; color: white;
				border: none; border-radius: 50%; cursor: pointer;
				display: flex; align-items: center; justify-content: center;
				font-size: 1.2rem;
				box-shadow: 0 4px 12px rgba(44, 82, 130, 0.3);
				transition: all 0.3s ease;
				opacity: 0; visibility: hidden; transform: translateY(20px);
				z-index: 1000;
			}
			.scroll-to-top.visible { opacity: 1; visibility: visible; transform: translateY(0); }
			.scroll-to-top:hover { background: #1A365D; transform: translateY(-2px); }
			body.dark-mode .scroll-to-top { background: #68D391; color: #1A202C; }
			body.dark-mode .scroll-to-top:hover { background: #48BB78; }
			@media (max-width: 768px) {
				.scroll-to-top { bottom: 1.5rem; right: 1.5rem; width: 45px; height: 45px; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="post-page">
			<div class="post-shell">
				<article class="post-article" data-post data-slug={slug}>
					<Breadcrumbs trail={[{ label: 'Inicio', href: '/' }, { label: 'Guías', href: '/guias/' }, { label: track.title, href: `/guias/${track.slug}/` }, { label: title }]} />

					<header class="post-hero">
						<!-- Único h1 del post -->
						<h1>{title}</h1>
						{description && <p class="post-dek">{description}</p>}
						<div class="post-meta">
							<span class="meta-tag">{categoryLabel}</span>
							<span class="meta-item">
								<FormattedDate date={pubDate} />
							</span>
							{readingMinutes && (
								<span class="meta-item" aria-label="Tiempo de lectura">· {readingMinutes} min de lectura</span>
							)}
							{updatedDate && (
								<span class="meta-item last-updated-on">
									· Actualizado <FormattedDate date={updatedDate} />
								</span>
							)}
							<LevelBadge level={level} type={type} subtrack={subtrack} />
							<ReadAloud />
						</div>
						<p id="readBadge" class="read-badge" hidden>✓ Ya leíste este artículo</p>
					</header>

					{heroImage || true ? (
						<div class="hero-image">
							<Image
								width={1024}
								height={480}
								src={heroImage && typeof heroImage === 'object' ? heroImage : DefaultImage}
								alt={title}
							/>
						</div>
					) : null}

					<!-- TOC colapsable: solo móvil/tablet, justo antes del contenido -->
					<div class="toc-mobile-wrap">
						<TableOfContents headings={headings} variant="mobile" />
					</div>

					<div class="post-body prose-content">
						<slot />
					</div>
					<RelatedGuides currentId={slug ?? ''} currentTags={tags ?? []} currentTrackSlug={track.slug} posts={related} />
					<div class="read-sentinel" aria-hidden="true"></div>
				</article>
				<aside class="post-sidebar" aria-label="Contenido lateral">
					<TableOfContents headings={headings} variant="sidebar" />
				</aside>
			</div>
		</main>

		<button id="scrollToTop" class="scroll-to-top" aria-label="Volver al inicio">↑</button>

		<Footer />

		<script>
			// Envuelve tablas del markdown en .table-scroll para overflow-x-auto en móvil.
			function wrapTables() {
				const root = document.querySelector('.prose-content');
				if (!root || root.dataset.tablesWrapped) return;
				root.dataset.tablesWrapped = 'true';
				root.querySelectorAll('table').forEach((table) => {
					if (table.parentElement?.classList.contains('table-scroll')) return;
					const wrap = document.createElement('div');
					wrap.className = 'table-scroll';
					wrap.setAttribute('tabindex', '0');
					wrap.setAttribute('role', 'region');
					wrap.setAttribute('aria-label', 'Tabla desplazable horizontalmente');
					table.before(wrap);
					wrap.appendChild(table);
				});
			}
			document.addEventListener('DOMContentLoaded', wrapTables);
			document.addEventListener('astro:page-load', wrapTables);
		</script>

		<script>
			// Lightbox: click en una imagen del post la expande a pantalla completa.
			if (!(window as any).__lightboxInit) {
				(window as any).__lightboxInit = true;
				function openLightbox(src: string, alt: string) {
					document.querySelector('.img-lightbox')?.remove();
					const overlay = document.createElement('div');
					overlay.className = 'img-lightbox';
					const full = document.createElement('img');
					full.src = src;
					full.alt = alt;
					overlay.appendChild(full);
					const closeBtn = document.createElement('button');
					closeBtn.className = 'img-lightbox-close';
					closeBtn.innerHTML = '&times;';
					closeBtn.setAttribute('aria-label', 'Cerrar imagen ampliada');
					closeBtn.addEventListener('click', (e) => {
						e.stopPropagation();
						overlay.remove();
					});
					overlay.appendChild(closeBtn);
					overlay.addEventListener('click', () => overlay.remove());
					document.body.appendChild(overlay);
				}
				document.addEventListener('click', (e) => {
					const target = e.target as HTMLImageElement;
					if (target?.tagName !== 'IMG') return;
					if (!target.closest('.post-article')) return;
					const link = target.closest('a');
					if (link) e.preventDefault();
					const src = target.getAttribute('src') || target.src;
					if (!src) return;
					openLightbox(src, target.alt || '');
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') document.querySelector('.img-lightbox')?.remove();
				});
			}
		</script>

		<script>
			document.addEventListener('DOMContentLoaded', function() {
				const scrollToTopButton = document.getElementById('scrollToTop');
				window.addEventListener('scroll', function() {
					if (window.pageYOffset > 300) {
						scrollToTopButton?.classList.add('visible');
					} else {
						scrollToTopButton?.classList.remove('visible');
					}
				});
				scrollToTopButton?.addEventListener('click', function() {
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
			});
		</script>

		<script>
			import { isRead, markAsRead } from '../lib/readStatus';
			function setupReadTracking() {
				const article = document.querySelector<HTMLElement>('article[data-slug]');
				if (!article || article.dataset.readInit) return;
				article.dataset.readInit = 'true';
				const slug = article.getAttribute('data-slug');
				if (!slug) return;
				const badge = document.getElementById('readBadge');
				if (badge && isRead(slug)) badge.hidden = false;
				const markAndShow = () => {
					markAsRead(slug);
					if (badge) badge.hidden = false;
				};
				const sentinel = document.querySelector('.read-sentinel');
				if (sentinel && 'IntersectionObserver' in window) {
					const observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									markAndShow();
									observer.disconnect();
								}
							}
						},
						{ threshold: 1 }
					);
					observer.observe(sentinel);
				} else {
					const onScroll = () => {
						const bottomReached =
							window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 200;
						if (bottomReached) {
							markAndShow();
							window.removeEventListener('scroll', onScroll);
						}
					};
					window.addEventListener('scroll', onScroll, { passive: true });
				}
			}
			document.addEventListener('DOMContentLoaded', setupReadTracking);
			document.addEventListener('astro:page-load', setupReadTracking);
		</script>
	</body>
</html>
